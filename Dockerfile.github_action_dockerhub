# Funnel fork: upstream's prebuilt v0.45.0 action image, plus our patches
# (GitHub inline verification + identity fallback + location dedup + separate
# review-state comment with per-file reconciliation) overlaid from this branch.
# Pinned tag keeps this exact; rebuilding from source on every run would add
# minutes for no benefit.
FROM pragent/pr-agent:0.45.0-github_action
COPY pr_agent/git_providers/github_provider.py /app/pr_agent/git_providers/github_provider.py
COPY pr_agent/tools/pr_reviewer.py /app/pr_agent/tools/pr_reviewer.py
COPY pr_agent/algo/review_finding_state.py /app/pr_agent/algo/review_finding_state.py
COPY pr_agent/algo/utils.py /app/pr_agent/algo/utils.py
